# The other option for two or three networks: peer A and C directly (both halves), no hub hop, no firewall.
# Rename to direct-peering.tf to use it (and drop the route tables for that pair).
resource "azurerm_virtual_network_peering" "a_to_c" {
  name                      = "a-to-c"
  resource_group_name       = azurerm_resource_group.net.name
  virtual_network_name      = azurerm_virtual_network.spoke["a"].name
  remote_virtual_network_id = azurerm_virtual_network.spoke["c"].id
}

resource "azurerm_virtual_network_peering" "c_to_a" {
  name                      = "c-to-a"
  resource_group_name       = azurerm_resource_group.net.name
  virtual_network_name      = azurerm_virtual_network.spoke["c"].name
  remote_virtual_network_id = azurerm_virtual_network.spoke["a"].id
}
