<?xml version="1.0" encoding="utf-8"?>
<!-- AZ-401 episode 6 - one feed per client configuration.
     Public packages (NuGet.org) come in through the feed's upstream sources, not as a second source here. -->
<configuration>
  <packageSources>
    <clear />
    <add key="pinecone-packages" value="https://pkgs.dev.azure.com/pinecone/pinecone-shop/_packaging/pinecone-packages/nuget/v3/index.json" />
  </packageSources>
</configuration>
